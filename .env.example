# ===========================================
# Pichouse SSR - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# -------------------------------------------
# Required: API Keys for Movie Data
# -------------------------------------------

# TMDb API Read Access Token (Required)
# Get yours at: https://www.themoviedb.org/settings/api
# Should start with "eyJ..."
TMDB_TOKEN=your_tmdb_read_access_token_here

# OMDB API Key (Required for fallback)
# Get yours at: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# Picturehouse API Cookie (Required)
# Get from browser dev tools when logged into Picturehouse
COOKIE=your_picturehouse_cookie_here

# -------------------------------------------
# Optional: Studio Trailers tab
# -------------------------------------------

# YouTube Data API v3 key (Optional)
# Powers the Trailers tab. Without it the site still builds and that tab is empty.
# Get yours at: https://console.cloud.google.com/apis/credentials
YT_API_KEY=your_youtube_api_key_here

# -------------------------------------------
# Optional: Cloudflare Deployment
# -------------------------------------------
# Only needed if deploying to Cloudflare Pages

# Cloudflare API Token with Pages Edit permission
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Your Cloudflare Account ID
# Find at: https://dash.cloudflare.com → Overview → Account ID
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
